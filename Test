            char.Archivable = true
            local clone = char:Clone()
            local junk = {Script=true, LocalScript=true, ModuleScript=true, Sound=true, ParticleEmitter=true, Beam=true, Trail=true, Fire=true, Smoke=true, Sparkles=true, PointLight=true, SpotLight=true, SurfaceLight=true, ForceField=true, Shirt=true, Pants=true, ShirtGraphic=true, Decal=true, Texture=true, Highlight=true, BillboardGui=true, SurfaceGui=true, Tool=true}
            local faceNames = {Face = true, Eyebrow = true, Eyelash = true}
            for _, d in ipairs(clone:GetDescendants()) do
                if junk[d.ClassName] or d:IsA("FaceControls") then d:Destroy()
                elseif d:IsA("Accessory") and faceNames[d.AccessoryType.Name] then d:Destroy() end
            end
            for _, d in ipairs(clone:GetDescendants()) do
                if d:IsA("MeshPart") then
                    d.TextureID = ""
                    d.Color = rgb(160)
                    d.Material = Enum.Material.SmoothPlastic
                    d.Reflectance = 0
                    d.Anchored = true
                    d.CanCollide = false
                elseif d:IsA("BasePart") then
                    d.Color = rgb(160)
                    d.Material = Enum.Material.SmoothPlastic
                    d.Reflectance = 0
                    d.Anchored = true
                    d.CanCollide = false
                elseif d:IsA("SurfaceAppearance") or d:IsA("SpecialMesh") then
                    d:Destroy()
                end
            end
            local hum = clone:FindFirstChildOfClass("Humanoid")
            if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
            clone.Parent = vpf
            clone:PivotTo(CFrame.new(0, 0, 0))
            local cf, size = clone:GetBoundingBox()
            local ctr = cf.Position
            local bse = clone:GetPivot()
            local wide = math.max(size.X, size.Z)
            local need = math.max(size.Y, wide / 0.67)
            local dist = need * 0.5 / math.tan(math.rad(15)) * 1.22
            cam.CFrame = CFrame.lookAt(ctr + Vector3.new(0, size.Y * 0.05, dist), ctr + Vector3.new(0, size.Y * 0.05, 0))
            clone:PivotTo(CFrame.new(ctr) * CFrame.Angles(0, math.rad(currentYaw), 0) * CFrame.new(-ctr) * bse)
            return clone
        end)
        return ok and m or nil
