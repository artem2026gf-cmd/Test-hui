local function applyConfig(cfg)
    if type(cfg) ~= "table" then return end
    for k, v in pairs(cfg) do
        local fn = controls[k]
        if fn then pcall(fn, v) end
    end
end
local function collectValues()
    local t = {}
    for k, v in pairs(runtime) do
        if typeof(v) == "Color3" then t[k] = {__color3 = true, r = v.R, g = v.G, b = v.B}
        else t[k] = v end
    end
    return t
end
local function decodeValues(t)
    if type(t) ~= "table" then return t end
    local out = {}
    for k, v in pairs(t) do
        if type(v) == "table" and v.__color3 then out[k] = Color3.new(v.r, v.g, v.b)
        else out[k] = v end
    end
    return out
end
