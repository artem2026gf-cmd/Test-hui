local CFG_FOLDER = "SwillNixware"
local CFG_FILE = CFG_FOLDER .. "/configs.json"
local hasFS = (writefile and readfile and isfolder and makefolder) and true or false

local function ensureFolder()
    if not hasFS then return end
    pcall(function() if not isfolder(CFG_FOLDER) then makefolder(CFG_FOLDER) end end)
end
local function loadConfigs()
    if not hasFS then return {} end
    ensureFolder()
    local ok, data = pcall(function() return readfile(CFG_FILE) end)
    if not ok or not data or data == "" then return {} end
    local ok2, dec = pcall(function() return HttpService:JSONDecode(data) end)
    if not ok2 or type(dec) ~= "table" then return {} end
    return dec
end
local function saveConfigs(t)
    if not hasFS then return end
    ensureFolder()
    local ok, enc = pcall(function() return HttpService:JSONEncode(t) end)
    if ok then pcall(function() writefile(CFG_FILE, enc) end) end
end

